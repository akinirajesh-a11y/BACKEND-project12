# RentEase backend environment
# Copy to .env (or your runtime env) — these map to application-prod.properties

DB_URL=jdbc:mysql://localhost:3306/rentease?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=changeme

# JWT secret — must be at least 32 characters for HS256
JWT_SECRET=change-this-to-a-long-random-secret-string

# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server port
PORT=8080